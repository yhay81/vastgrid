{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!!**/node_modules", "!!**/dist", "!!**/.data", "!**/package-lock.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "rules": { "preset": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "css": { "parser": { "cssModules": false } },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } }
    },
    {
      "includes": ["**/*.astro"],
      "linter": { "rules": { "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" } } }
    },
    {
      "includes": ["packages/spec/conformance/*.json"],
      "formatter": { "enabled": false }
    }
  ]
}
