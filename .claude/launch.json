{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "vastgrid-site", "run", "dev", "--port", "4321"],
      "port": 4321
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "vastgrid-site", "run", "preview", "--port", "4322"],
      "port": 4322
    },
    {
      "name": "bench",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "vastgrid-bench", "run", "preview"],
      "port": 5181
    },
    {
      "name": "files",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "vastgrid-files-example", "run", "preview"],
      "port": 5183
    },
    {
      "name": "cli",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "packages/cli/dist/cli.js",
        "--no-open",
        "--save",
        "--port",
        "5185",
        ".data/cli",
        ".data/bench/sales-100000000.parquet"
      ],
      "port": 5185
    },
    {
      "name": "mcp-host",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "vpx", "packages/mcp/host/serve.ts", ".data", "5184"],
      "port": 5184
    }
  ]
}
