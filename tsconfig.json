{
  "//": "For tools that read the tsconfig of the folder they run in, such as vpx and the type-aware rules of `pnpm run lint`, and for the tests in editors; packages build with their own.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "packages/*/perf",
    "packages/*/bench",
    "scripts/*.ts",
    "scripts/test",
    "e2e",
    "playwright.config.ts"
  ]
}
