---
import "../../styles/open.css";
import AppShell from "../AppShell.astro";
import OpenApp from "./OpenApp.tsx";

interface Props {
  language: "en" | "ja";
}

const { language } = Astro.props;
const texts = {
  en: {
    title: "Open a file — vastgrid",
    description:
      "Open a CSV, TSV, JSON Lines, Parquet or Excel file in your browser with vastgrid: sort, filter, group, edit and export it, without uploading it.",
    noscript: "This page needs JavaScript.",
  },
  ja: {
    title: "ファイルを開く — vastgrid",
    description:
      "CSV・TSV・JSON Lines・Parquet・Excel のファイルを vastgrid でブラウザーの中で開き、アップロードせずに並べ替え・絞り込み・グループ化・編集・書き出しができます。",
    noscript: "このページには JavaScript が必要です。",
  },
}[language];
---

<AppShell
  language={language}
  paths={{ en: "/open/", ja: "/ja/open/" }}
  title={texts.title}
  description={texts.description}
  noscript={texts.noscript}
>
  <OpenApp client:only="react" language={language} />
</AppShell>
