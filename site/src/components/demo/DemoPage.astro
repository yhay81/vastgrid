---
import AppShell from "../AppShell.astro";
import DemoApp from "./DemoApp.tsx";

interface Props {
  language: "en" | "ja";
}

const { language } = Astro.props;
const texts = {
  en: {
    title: "vastgrid demo",
    description:
      "Try vastgrid, a canvas data grid for React: sort, filter, group, edit and export 200,000 orders in your browser.",
    noscript: "The demo needs JavaScript.",
  },
  ja: {
    title: "vastgrid デモ",
    description:
      "キャンバスに描く React のデータグリッド vastgrid を試せます。ブラウザーの中の 20 万件の注文を並べ替え・絞り込み・グループ化・編集・書き出し。",
    noscript: "デモには JavaScript が必要です。",
  },
}[language];
---

<AppShell
  language={language}
  paths={{ en: "/demo/", ja: "/ja/demo/" }}
  title={texts.title}
  description={texts.description}
  noscript={texts.noscript}
>
  <DemoApp client:only="react" language={language} />
</AppShell>
