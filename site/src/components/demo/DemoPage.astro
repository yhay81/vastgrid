---
import "../../styles/demo.css";
import DemoApp from "./DemoApp.tsx";

interface Props {
  language: "en" | "ja";
}

const { language } = Astro.props;
const texts = {
  en: {
    title: "vastgrid demo",
    description:
      "Try vastgrid, a canvas data grid for React: 200,000 orders in memory and a billion rows computed as you scroll.",
    noscript: "The demo needs JavaScript.",
  },
  ja: {
    title: "vastgrid デモ",
    description:
      "キャンバスに描く React のデータグリッド vastgrid を試せます。メモリ上の 20 万件の注文と、スクロールに合わせて計算する 10 億行。",
    noscript: "デモには JavaScript が必要です。",
  },
}[language];
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{texts.title}</title>
    <meta name="description" content={texts.description} />
    <meta property="og:title" content={texts.title} />
    <meta property="og:description" content={texts.description} />
    <meta property="og:image" content="https://vastgrid.yhay81.com/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href="https://vastgrid.yhay81.com/demo/" />
    <link rel="alternate" hreflang="ja" href="https://vastgrid.yhay81.com/ja/demo/" />
    <script is:inline>
      // Apply the stored theme before the first paint, as the documentation does.
      try {
        const theme = localStorage.getItem("starlight-theme");
        if (theme === "light" || theme === "dark") document.documentElement.style.colorScheme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <DemoApp client:only="react" language={language} />
    <noscript>{texts.noscript}</noscript>
  </body>
</html>
