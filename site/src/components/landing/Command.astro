---
// A command to run, with a button that copies it.
import Icon from "./Icon.astro";

interface Props {
  command: string;
  copy: string;
  copied: string;
  class?: string;
}

const { command, copy, copied, class: className } = Astro.props;
---

<div class:list={["lp-command", className]}>
  <code
    ><span class="lp-command__prompt" aria-hidden="true">$</span>{
      // Each word whole, so that a long command wraps only at its spaces.
      command.split(" ").map((word, index) => (
        <>
          {index > 0 && " "}
          <span class="lp-command__word">{word}</span>
        </>
      ))
    }</code
  >
  <button type="button" class="lp-command__copy" data-lp-copy={command} data-copied-label={copied} aria-label={copy}>
    <Icon name="copy" size={16} class="lp-command__icon" />
    <Icon name="check" size={16} class="lp-command__done" />
  </button>
  <span class="lp-sr" aria-live="polite"></span>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-lp-copy]")) {
    let timer: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.lpCopy ?? "");
      } catch {
        return; // The page may not be allowed the clipboard; the command stays there to select.
      }
      const status = button.nextElementSibling;
      if (status) status.textContent = button.dataset.copiedLabel ?? "";
      button.dataset.copied = "";
      clearTimeout(timer);
      timer = setTimeout(() => {
        delete button.dataset.copied;
        if (status) status.textContent = "";
      }, 1600);
    });
  }
</script>
