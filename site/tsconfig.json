{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["vastgrid-source"],
    "types": ["node", "astro/client"]
  },
  "include": ["src/components", "src/data", "src/content.config.ts", "astro.config.ts"]
}
