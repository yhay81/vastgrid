{
  "name": "vastgrid-vscode",
  "displayName": "%displayName%",
  "version": "0.4.0",
  "private": true,
  "description": "%description%",
  "license": "MIT",
  "author": "yhay81",
  "publisher": "yhay81",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhay81/vastgrid.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://vastgrid.yhay81.com",
  "bugs": "https://github.com/yhay81/vastgrid/issues",
  "qna": "https://github.com/yhay81/vastgrid/issues",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1a2a4a",
    "theme": "dark"
  },
  "pricing": "Free",
  "type": "module",
  "main": "./dist/extension.cjs",
  "l10n": "./l10n",
  "exports": {
    ".": {
      "vastgrid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=20"
  },
  "categories": [
    "Data Science",
    "Visualization"
  ],
  "keywords": [
    "csv",
    "tsv",
    "parquet",
    "excel",
    "xlsx",
    "jsonl",
    "ndjson",
    "json lines",
    "duckdb",
    "csv viewer",
    "csv editor",
    "parquet viewer",
    "excel viewer",
    "jsonl viewer",
    "data viewer",
    "data preview",
    "large csv",
    "large files",
    "big data",
    "table",
    "data grid",
    "spreadsheet",
    "dataframe",
    "tabular data",
    "gzip",
    "zstd"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrustedWorkspaces%"
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "vastgrid.table",
        "displayName": "vastgrid",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.pq"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "*.duckdb"
          },
          {
            "filenamePattern": "*.ddb"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "vastgrid.text",
        "displayName": "vastgrid",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.tab"
          },
          {
            "filenamePattern": "*.csv.gz"
          },
          {
            "filenamePattern": "*.tsv.gz"
          },
          {
            "filenamePattern": "*.csv.zst"
          },
          {
            "filenamePattern": "*.tsv.zst"
          },
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          },
          {
            "filenamePattern": "*.jsonl.gz"
          },
          {
            "filenamePattern": "*.ndjson.gz"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "vastgrid.open",
        "title": "%command.open%",
        "category": "vastgrid",
        "icon": {
          "light": "media/open-light.svg",
          "dark": "media/open-dark.svg"
        }
      },
      {
        "command": "vastgrid.sheet",
        "title": "%command.sheet%",
        "category": "vastgrid"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vastgrid.open",
          "when": "resourceFilename =~ /\\.(csv|tsv|tab|jsonl|ndjson)(\\.gz|\\.zst)?$/i",
          "group": "navigation@20"
        }
      ],
      "editor/title": [
        {
          "command": "vastgrid.open",
          "when": "resourceFilename =~ /\\.(csv|tsv|tab|jsonl|ndjson)$/i && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "vastgrid.open",
          "when": "resourceFilename =~ /\\.(csv|tsv|tab|jsonl|ndjson|parquet|pq|xlsx|xlsm)(\\.gz|\\.zst)?$|\\.(duckdb|ddb)$/i"
        },
        {
          "command": "vastgrid.sheet",
          "when": "activeCustomEditorId == vastgrid.table && resourceFilename =~ /\\.(xlsx|xlsm|duckdb|ddb)$/i"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "start",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "open",
            "title": "%walkthrough.open.title%",
            "description": "%walkthrough.open.description%",
            "media": {
              "image": "media/walkthrough/open.png",
              "altText": "%walkthrough.open.alt%"
            },
            "completionEvents": [
              "onContext:activeCustomEditorId == vastgrid.table || activeCustomEditorId == vastgrid.text"
            ]
          },
          {
            "id": "explore",
            "title": "%walkthrough.explore.title%",
            "description": "%walkthrough.explore.description%",
            "media": {
              "image": "media/walkthrough/filter.png",
              "altText": "%walkthrough.explore.alt%"
            }
          },
          {
            "id": "select",
            "title": "%walkthrough.select.title%",
            "description": "%walkthrough.select.description%",
            "media": {
              "image": "media/walkthrough/select.png",
              "altText": "%walkthrough.select.alt%"
            }
          },
          {
            "id": "edit",
            "title": "%walkthrough.edit.title%",
            "description": "%walkthrough.edit.description%",
            "media": {
              "image": "media/walkthrough/edit.png",
              "altText": "%walkthrough.edit.alt%"
            },
            "completionEvents": [
              "onContext:activeCustomEditorId == vastgrid.text && activeEditorIsDirty"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc -b && node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "test:vscode": "node scripts/test-vscode.mjs"
  },
  "dependencies": {
    "@duckdb/node-bindings": "catalog:",
    "vastgrid": "workspace:*",
    "vastgrid-duckdb": "workspace:*",
    "vastgrid-spec": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "ovsx": "1.3.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
