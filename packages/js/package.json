{
  "name": "vastgrid-js",
  "version": "0.2.2",
  "description": "vastgrid's engine in memory, for the browser and Node.js: tables of rows, Apache Arrow, CSV, TSV, JSON Lines, Excel and Parquet files (over HTTP ranges too), with sorting, filters, groups, pivots, formulas, writes and exports.",
  "keywords": [
    "data grid",
    "csv",
    "parquet",
    "excel",
    "xlsx",
    "arrow",
    "in-memory",
    "web worker"
  ],
  "license": "MIT",
  "author": "yhay81",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhay81/vastgrid.git",
    "directory": "packages/js"
  },
  "homepage": "https://vastgrid.yhay81.com",
  "bugs": "https://github.com/yhay81/vastgrid/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "vastgrid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "hyparquet": "1.31.5",
    "hyparquet-compressors": "1.1.2",
    "vastgrid-spec": "0.2.2"
  }
}
