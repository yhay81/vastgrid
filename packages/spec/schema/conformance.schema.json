{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vastgrid.yhay81.com/schema/0.2/conformance.schema.json",
  "title": "vastgrid 0.2 conformance cases",
  "description": "A file of the conformance corpus (docs/spec.md §10): tables, and cases that run a plan on one of them. Plans are not checked by this schema, so that cases can test invalid plans.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tables", "cases"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tables": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/table"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "value": {
      "type": ["string", "number", "boolean", "null"]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "plan.schema.json#/$defs/type"
        },
        "precision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 38
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 38
        },
        "bits": {
          "enum": [32, 64]
        },
        "unit": {
          "enum": ["s", "ms", "us", "ns"]
        },
        "sourceType": {
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        },
        "pivot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values", "measure"],
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            },
            "measure": {
              "type": "string"
            }
          }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/value"
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "table", "plan", "expect"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        "section": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)*$"
        },
        "description": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "plan": {},
        "read": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "expect": {
          "oneOf": [
            {
              "$ref": "#/$defs/result"
            },
            {
              "$ref": "#/$defs/failure"
            }
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowCount", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/value"
            }
          }
        },
        "rowIds": {
          "type": ["array", "null"],
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
