{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vastgrid.yhay81.com/schema/v2/messages.schema.json",
  "title": "vastgrid v2 messages",
  "description": "Requests, responses, errors and events (docs/v2-spec.md §8), with blocks in the text or attached encoding (§8.8). A response's result has the form of $defs/result/<op> for the operation of its request. Plans are checked against the table by the engine (§4.7); checkRequest also checks the limits of §8 that a schema cannot (rows and cells of a request, code points of strings).",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "id", "op", "ref"],
          "properties": {
            "v": {
              "const": 2
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "open"
            },
            "ref": {
              "type": "string"
            },
            "read": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sheet": {
                  "type": "string"
                },
                "headerRow": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "keepEmptyRows": {
                  "type": "boolean"
                },
                "keepEmptyColumns": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "id", "op", "table"],
          "properties": {
            "v": {
              "const": 2
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "info"
            },
            "table": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "id", "op", "table", "revision", "plan", "start", "end", "columns"],
          "properties": {
            "v": {
              "const": 2
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "rows"
            },
            "table": {
              "type": "string"
            },
            "revision": {
              "type": ["string", "null"]
            },
            "plan": {
              "type": "object"
            },
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "textLimit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "preview": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "id", "op", "table", "revision", "plan", "ranges", "columns"],
          "properties": {
            "v": {
              "const": 2
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "summarize"
            },
            "table": {
              "type": "string"
            },
            "revision": {
              "type": ["string", "null"]
            },
            "plan": {
              "type": "object"
            },
            "ranges": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "id", "op", "table", "revision", "plan", "text", "columns", "from", "direction"],
          "properties": {
            "v": {
              "const": 2
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "find"
            },
            "table": {
              "type": "string"
            },
            "revision": {
              "type": ["string", "null"]
            },
            "plan": {
              "type": "object"
            },
            "text": {
              "type": "string"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "from": {
              "type": "object",
              "additionalProperties": false,
              "required": ["row", "column"],
              "properties": {
                "row": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "column": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "direction": {
              "enum": [1, -1]
            },
            "caseSensitive": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "id", "op", "table", "revision", "plan", "keys"],
          "properties": {
            "v": {
              "const": 2
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "locate"
            },
            "table": {
              "type": "string"
            },
            "revision": {
              "type": ["string", "null"]
            },
            "plan": {
              "type": "object"
            },
            "keys": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "$ref": "state.schema.json#/$defs/rowKey"
              }
            },
            "rowKey": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "id", "op", "table", "revision", "updates"],
          "properties": {
            "v": {
              "const": 2
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "write"
            },
            "table": {
              "type": "string"
            },
            "revision": {
              "type": ["string", "null"]
            },
            "updates": {
              "type": "array",
              "maxItems": 100000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "column", "value"],
                "properties": {
                  "key": {
                    "$ref": "state.schema.json#/$defs/rowKey"
                  },
                  "column": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "state.schema.json#/$defs/value"
                  },
                  "previous": {
                    "$ref": "state.schema.json#/$defs/value"
                  }
                }
              }
            },
            "rowKey": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "id", "op", "table"],
          "properties": {
            "v": {
              "const": 2
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "save"
            },
            "table": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "id", "op", "table", "revision", "plan", "format"],
          "properties": {
            "v": {
              "const": 2
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "export"
            },
            "table": {
              "type": "string"
            },
            "revision": {
              "type": ["string", "null"]
            },
            "plan": {
              "type": "object"
            },
            "format": {
              "enum": ["csv", "tsv", "parquet", "json", "xlsx"]
            },
            "target": {
              "type": "string"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "numberFormats": {
              "type": "array",
              "items": {
                "type": ["string", "null"]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "id", "op", "table"],
          "properties": {
            "v": {
              "const": 2
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "changes"
            },
            "table": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "id", "op", "table"],
          "properties": {
            "v": {
              "const": 2
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "reload"
            },
            "table": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "id", "op", "request"],
          "properties": {
            "v": {
              "const": 2
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "cancel"
            },
            "request": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "id", "op", "table"],
          "properties": {
            "v": {
              "const": 2
            },
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "close"
            },
            "table": {
              "type": "string"
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "result"],
      "properties": {
        "v": {
          "const": 2
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "result": {}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "error"],
      "properties": {
        "v": {
          "const": 2
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "invalid_plan",
                "table_not_found",
                "not_ready",
                "revision_changed",
                "edit_conflict",
                "file_changed",
                "read_only",
                "not_allowed",
                "invalid_value",
                "too_many_columns",
                "save_unsupported",
                "load_failed",
                "export_too_large",
                "cancelled",
                "internal"
              ]
            },
            "message": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "details": {
              "type": "object"
            }
          }
        }
      }
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "event", "table", "revision", "edits"],
          "properties": {
            "v": {
              "const": 2
            },
            "event": {
              "const": "changed"
            },
            "table": {
              "type": "string"
            },
            "revision": {
              "type": ["string", "null"]
            },
            "edits": {
              "$ref": "#/$defs/edits"
            },
            "fileChanged": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "event", "table", "status", "progress", "readableRows", "rowCount"],
          "properties": {
            "v": {
              "const": 2
            },
            "event": {
              "const": "progress"
            },
            "table": {
              "type": "string"
            },
            "status": {
              "enum": ["loading", "ready", "error"]
            },
            "progress": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "readableRows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rowCount": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "event", "table", "hash", "status", "readableRows", "rowCount", "rowCountExact"],
          "properties": {
            "v": {
              "const": 2
            },
            "event": {
              "const": "view"
            },
            "table": {
              "type": "string"
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "status": {
              "enum": ["building", "ready"]
            },
            "readableRows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rowCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rowCountExact": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "open": {
          "$ref": "#/$defs/tableInfo"
        },
        "info": {
          "$ref": "#/$defs/tableInfo"
        },
        "rows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["view", "start", "end", "rowIds", "block"],
          "properties": {
            "view": {
              "type": "object",
              "additionalProperties": false,
              "required": ["hash", "status", "rowCount", "rowCountExact", "readableRows", "columns", "edits"],
              "properties": {
                "hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "status": {
                  "enum": ["building", "ready"]
                },
                "rowCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "rowCountExact": {
                  "type": "boolean"
                },
                "readableRows": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "$ref": "conformance.schema.json#/$defs/column"
                  }
                },
                "edits": {
                  "$ref": "#/$defs/edits"
                },
                "partial": {
                  "type": "boolean"
                }
              }
            },
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rowIds": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "block": {
              "$ref": "#/$defs/block"
            },
            "truncated": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        },
        "summarize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "numericCount", "sum", "min", "max", "average"],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "numericCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sum": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "enum": ["Infinity", "-Infinity", null]
                }
              ]
            },
            "min": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "enum": ["Infinity", "-Infinity", null]
                }
              ]
            },
            "max": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "enum": ["Infinity", "-Infinity", null]
                }
              ]
            },
            "average": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "enum": ["Infinity", "-Infinity", null]
                }
              ]
            }
          }
        },
        "find": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["row", "column"],
              "properties": {
                "row": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "column": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "locate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows"],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "write": {
          "type": "object",
          "additionalProperties": false,
          "required": ["updated", "edits"],
          "properties": {
            "updated": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "edits": {
              "$ref": "#/$defs/edits"
            }
          }
        },
        "save": {
          "type": "object",
          "additionalProperties": false,
          "required": ["records", "edits"],
          "properties": {
            "records": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "edits": {
              "$ref": "#/$defs/edits"
            }
          }
        },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "rows"],
          "properties": {
            "target": {
              "type": ["string", "null"]
            },
            "rows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "data": {
              "$ref": "#/$defs/block"
            }
          }
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "edits"],
          "properties": {
            "revision": {
              "type": ["string", "null"]
            },
            "edits": {
              "$ref": "#/$defs/edits"
            },
            "fileChanged": {
              "type": "boolean"
            }
          }
        },
        "reload": {
          "$ref": "#/$defs/tableInfo"
        },
        "close": {
          "type": "null"
        }
      }
    },
    "tableInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "revision",
        "edits",
        "status",
        "progress",
        "rowCount",
        "readableRows",
        "columns",
        "capabilities"
      ],
      "properties": {
        "table": {
          "type": "string"
        },
        "revision": {
          "type": ["string", "null"]
        },
        "edits": {
          "$ref": "#/$defs/edits"
        },
        "status": {
          "enum": ["loading", "ready", "error"]
        },
        "progress": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rowCount": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "readableRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "conformance.schema.json#/$defs/column"
          }
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "format": {
          "type": "string"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sheets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string"
              },
              "hidden": {
                "type": "boolean"
              }
            }
          }
        },
        "sheet": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "fileChanged": {
          "type": "boolean"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "derive": {
