{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vastgrid.yhay81.com/schema/0.2/plan.schema.json",
  "title": "vastgrid 0.2 plan",
  "description": "A view of a table (docs/spec.md §4.1). This schema checks the JSON form only; names, types and limits are checked against the table (§4.7).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "derive": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/derived" } },
    "where": { "$ref": "#/$defs/expression" },
    "aggregate": { "$ref": "#/$defs/aggregate" },
    "having": { "$ref": "#/$defs/expression" },
    "sort": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/sortKey" } }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "type": {
      "enum": [
        "boolean",
        "integer",
        "bigint",
        "decimal",
        "float",
        "string",
        "date",
        "time",
        "timestamp",
        "timestamptz",
        "interval",
        "uuid",
        "binary"
      ]
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expr"],
      "properties": { "name": { "$ref": "#/$defs/name" }, "expr": { "$ref": "#/$defs/expression" } }
    },
    "expression": {
      "oneOf": [
        { "$ref": "#/$defs/column" },
        { "$ref": "#/$defs/literal" },
        { "$ref": "#/$defs/call" },
        { "$ref": "#/$defs/search" }
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["col"],
      "properties": { "col": { "$ref": "#/$defs/name" } }
    },
    "literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lit"],
      "properties": {
        "lit": { "type": ["boolean", "number", "string", "null"] },
        "type": { "$ref": "#/$defs/type" }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fn", "args"],
      "properties": {
        "fn": {
          "enum": [
            "and",
            "or",
            "not",
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "in",
            "is_null",
            "is_blank",
            "if",
            "coalesce",
            "least",
            "greatest",
            "add",
            "sub",
            "mul",
            "div",
            "mod",
            "neg",
            "abs",
            "round",
            "floor",
            "ceil",
            "bin",
            "sqrt",
            "exp",
            "ln",
            "log10",
            "power",
            "sign",
            "to_number",
            "concat",
            "length",
            "lower",
            "upper",
            "trim",
            "left",
            "right",
            "substr",
            "replace",
            "contains",
            "starts_with",
            "ends_with",
            "text",
            "to_date",
            "to_timestamp",
            "year",
            "month",
            "day",
            "hour",
            "minute",
            "second",
            "isodow",
            "date_diff_days",
            "add_days"
          ]
        },
        "args": { "type": "array", "items": { "$ref": "#/$defs/expression" } }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["search"],
      "properties": { "search": { "type": "string", "minLength": 1 } }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys", "measures"],
      "properties": {
        "keys": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
        "measures": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/measure" } },
        "pivot": { "$ref": "#/$defs/pivot" }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fn"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "fn": { "enum": ["count", "count_distinct", "sum", "avg", "stddev", "min", "max", "quantile"] },
        "column": { "$ref": "#/$defs/name" },
        "p": { "type": "number", "minimum": 0, "maximum": 1 },
        "approx": { "type": "boolean" }
      }
    },
    "pivot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "maxColumns": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "sortKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "direction"],
      "properties": { "column": { "$ref": "#/$defs/name" }, "direction": { "enum": ["asc", "desc"] } }
    }
  }
}
