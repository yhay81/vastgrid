{
  "name": "vastgrid-spec",
  "version": "0.0.0",
  "description": "The vastgrid specification as code: types, plan checking, the commands of the document and session, the normal form and hash of plans, the message schemas, and the conformance corpus.",
  "keywords": [
    "data grid",
    "specification",
    "conformance",
    "arrow",
    "json schema"
  ],
  "license": "MIT",
  "author": "yhay81",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhay81/vastgrid.git",
    "directory": "packages/spec"
  },
  "homepage": "https://vastgrid.yhay81.com",
  "bugs": "https://github.com/yhay81/vastgrid/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "vastgrid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./columns": {
      "vastgrid-source": "./src/columns.ts",
      "types": "./dist/columns.d.ts",
      "default": "./dist/columns.js"
    },
    "./conformance": {
      "vastgrid-source": "./src/conformance.ts",
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    },
    "./export": {
      "vastgrid-source": "./src/export.ts",
      "types": "./dist/export.d.ts",
      "default": "./dist/export.js"
    },
    "./workbook": {
      "vastgrid-source": "./src/workbook.ts",
      "types": "./dist/workbook.d.ts",
      "default": "./dist/workbook.js"
    },
    "./xlsx": {
      "vastgrid-source": "./src/xlsx.ts",
      "types": "./dist/xlsx.d.ts",
      "default": "./dist/xlsx.js"
    },
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "conformance"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@uwdata/flechette": "2.6.0"
  }
}
