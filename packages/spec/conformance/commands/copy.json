  "cases": [
    {
      "id": "copy.cells",
      "section": "6.6",
      "state": {},
      "context": "orders",
      "commands": [
        {
          "command": "select",
          "row": 0,
          "column": "region"
        },
        {
          "command": "select",
          "row": 1,
          "column": "qty",
          "mode": "extend"
        },
        {
          "command": "copy"
        }
      ],
      "expect": {
        "output": {
          "tsv": "Tokyo\t3\nOsaka\t1",
          "html": "<meta charset=\"utf-8\"><table><tr><td>Tokyo</td><td>3</td></tr><tr><td>Osaka</td><td>1</td></tr></table>",
          "markdown": "|  |  |\n| --- | --- |\n| Tokyo | 3 |\n| Osaka | 1 |"
        },
        "requests": []
      }
    },
    {
      "id": "copy.headers",
      "section": "6.6",
      "state": {},
      "context": "orders",
      "commands": [
        {
          "command": "select",
          "row": 0,
          "column": "region"
        },
        {
          "command": "select",
          "row": 1,
          "column": "qty",
          "mode": "extend"
        },
        {
          "command": "copy",
          "headers": true
        }
      ],
      "expect": {
        "output": {
          "tsv": "region\tqty\nTokyo\t3\nOsaka\t1",
          "html": "<meta charset=\"utf-8\"><table><tr><th>region</th><th>qty</th></tr><tr><td>Tokyo</td><td>3</td></tr><tr><td>Osaka</td><td>1</td></tr></table>",
          "markdown": "| region | qty |\n| --- | --- |\n| Tokyo | 3 |\n| Osaka | 1 |"
        }
      }
    },
    {
      "id": "copy.text-forms",
      "section": "2.4",
      "description": "Values are copied as their text forms, and null as the empty string.",
      "state": {},
      "context": "orders",
      "commands": [
        {
          "command": "select",
          "row": 0,
          "column": "id"
        },
        {
          "command": "select",
          "row": 2,
          "column": "note",
          "mode": "extend"
        },
        {
          "command": "copy"
        }
      ],
      "expect": {
        "output": {
          "tsv": "1\tTokyo\t3\t12.50\t2024-01-31\ta\n2\tOsaka\t1\t8.00\t2024-02-01\t\n3\tTokyo\t\t\t\tc",
          "html": "<meta charset=\"utf-8\"><table><tr><td>1</td><td>Tokyo</td><td>3</td><td>12.50</td><td>2024-01-31</td><td>a</td></tr><tr><td>2</td><td>Osaka</td><td>1</td><td>8.00</td><td>2024-02-01</td><td></td></tr><tr><td>3</td><td>Tokyo</td><td></td><td></td><td></td><td>c</td></tr></table>",
          "markdown": "|  |  |  |  |  |  |\n| --- | --- | --- | --- | --- | --- |\n| 1 | Tokyo | 3 | 12.50 | 2024-01-31 | a |\n| 2 | Osaka | 1 | 8.00 | 2024-02-01 |  |\n| 3 | Tokyo |  |  |  | c |"
        }
      }
    },
    {
      "id": "copy.escapes",
      "section": "6.6",
      "state": {},
      "context": "texts",
      "commands": [
