          "command": "select",
          "row": 4,
          "column": "s",
          "mode": "extend"
        },
        {
          "command": "copy"
        }
      ],
      "expect": {
        "output": {
          "tsv": "\"a\tb\"\n\"say \"\"hi\"\"\"\n\"line1\nline2\"\n\nx|y & <z>",
          "html": "<meta charset=\"utf-8\"><table><tr><td>a\tb</td></tr><tr><td>say &quot;hi&quot;</td></tr><tr><td>line1<br>line2</td></tr><tr><td></td></tr><tr><td>x|y &amp; &lt;z&gt;</td></tr></table>",
          "markdown": "|  |\n| --- |\n| a\tb |\n| say \"hi\" |\n| line1<br>line2 |\n|  |\n| x\\|y & <z> |"
        }
      }
    },
    {
      "id": "copy.floats",
      "section": "2.4.1",
      "description": "Floats are copied as their text form (§2.4.1), 32-bit floats with their own shortest digits.",
      "state": {},
      "context": "floats",
      "commands": [
