      ],
      "expect": {
        "output": {
          "tsv": "0.1\t0.1\nnan\t16777216.0\n1e+20\t1.0\n1.0\tinf\n1e-05\t-inf",
          "html": "<meta charset=\"utf-8\"><table><tr><td>0.1</td><td>0.1</td></tr><tr><td>nan</td><td>16777216.0</td></tr><tr><td>1e+20</td><td>1.0</td></tr><tr><td>1.0</td><td>inf</td></tr><tr><td>1e-05</td><td>-inf</td></tr></table>",
          "markdown": "|  |  |\n| --- | --- |\n| 0.1 | 0.1 |\n| nan | 16777216.0 |\n| 1e+20 | 1.0 |\n| 1.0 | inf |\n| 1e-05 | -inf |"
        }
      }
    },
    {
      "id": "copy.side-by-side",
