{
  "name": "vastgrid-duckdb",
  "version": "0.1.1",
  "description": "A vastgrid table server backed by DuckDB: opens huge CSV, TSV, Parquet and JSON Lines files and Excel workbooks in Node.js.",
  "license": "MIT",
  "author": "yhay81",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhay81/vastgrid.git",
    "directory": "packages/duckdb"
  },
  "homepage": "https://vastgrid.yhay81.com",
  "bugs": "https://github.com/yhay81/vastgrid/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "vastgrid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "duckdb",
    "csv",
    "parquet",
    "datagrid",
    "nodejs",
    "big-data"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "vastgrid-core": "^0.1.1",
    "@duckdb/node-api": "1.5.6-r.1"
  }
}
