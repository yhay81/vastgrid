{
  "name": "vastgrid-duckdb",
  "version": "0.4.1",
  "description": "vastgrid's DuckDB engine for Node.js: opens huge CSV, TSV, Parquet, JSON and JSON Lines files, Excel workbooks and DuckDB databases, writes their cells and saves CSV and TSV files with the bytes that were not edited kept, and answers the grid over HTTP or in the same process.",
  "keywords": [
    "duckdb",
    "data grid",
    "csv",
    "tsv",
    "parquet",
    "json",
    "ndjson",
    "excel",
    "xlsx",
    "server"
  ],
  "license": "MIT",
  "author": "yhay81",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhay81/vastgrid.git",
    "directory": "packages/duckdb-engine"
  },
  "homepage": "https://vastgrid.yhay81.com",
  "bugs": "https://github.com/yhay81/vastgrid/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "vastgrid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@duckdb/node-api": "catalog:",
    "fzstd": "0.1.1",
    "hyparquet": "1.32.0",
    "vastgrid-spec": "workspace:*",
    "vastgrid-sql": "workspace:*"
  },
  "devDependencies": {
    "vastgrid": "workspace:*",
    "vastgrid-js": "workspace:*"
  }
}
