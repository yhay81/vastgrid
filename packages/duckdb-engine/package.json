{
  "name": "vastgrid-duckdb",
  "version": "0.0.0",
  "description": "vastgrid's DuckDB engine for Node.js: opens huge CSV, TSV, Parquet and JSON Lines files and Excel workbooks, writes their cells and saves CSV and TSV files with the bytes that were not edited kept, and answers the grid over HTTP or in the same process.",
  "keywords": [
    "duckdb",
    "data grid",
    "csv",
    "tsv",
    "parquet",
    "excel",
    "xlsx",
    "server"
  ],
  "license": "MIT",
  "author": "yhay81",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhay81/vastgrid.git",
    "directory": "packages/duckdb-engine"
  },
  "homepage": "https://vastgrid.yhay81.com",
  "bugs": "https://github.com/yhay81/vastgrid/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "vastgrid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "vastgrid-spec": "0.0.0",
    "vastgrid-sql": "0.0.0"
  },
  "devDependencies": {
    "vastgrid": "0.0.0",
    "vastgrid-js": "0.0.0"
  }
}
