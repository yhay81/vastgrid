{
  "name": "vastgrid-cli",
  "version": "0.2.0-next.1",
  "description": "Open huge CSV, TSV, Parquet, JSON Lines and Excel files in a grid in the browser with one command, read by DuckDB on this computer: npx vastgrid-cli data.parquet",
  "keywords": [
    "csv",
    "tsv",
    "parquet",
    "excel",
    "xlsx",
    "duckdb",
    "viewer",
    "cli",
    "data grid"
  ],
  "license": "MIT",
  "author": "yhay81",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhay81/vastgrid.git",
    "directory": "packages/cli"
  },
  "homepage": "https://vastgrid.yhay81.com",
  "bugs": "https://github.com/yhay81/vastgrid/issues",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "vastgrid": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "vastgrid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-app.mjs"
  },
  "dependencies": {
    "vastgrid-duckdb": "0.2.0-next.1"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vastgrid": "0.2.0-next.1"
  }
}
