{
  "name": "vastgrid-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "An MCP App of vastgrid v2: huge CSV, TSV, Parquet, JSON Lines and Excel files in a grid inside the chat, read by DuckDB on the server, with the agent reading and changing the same view and cells that the person sees.",
  "license": "MIT",
  "author": "yhay81",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhay81/vastgrid.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://vastgrid.yhay81.com",
  "bugs": "https://github.com/yhay81/vastgrid/issues",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "vastgrid-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "vastgrid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-app.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.4.0",
    "vastgrid-duckdb-engine": "0.0.0",
    "vastgrid-grid": "0.0.0",
    "vastgrid-spec": "0.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
