{
  "name": "vastgrid",
  "version": "0.1.1",
  "description": "A canvas data grid for React that opens CSV, TSV, Parquet and JSON Lines files of any size, with spreadsheet selection, sorting, filters and statistics.",
  "license": "MIT",
  "author": "yhay81",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhay81/vastgrid.git",
    "directory": "packages/react"
  },
  "homepage": "https://vastgrid.yhay81.com",
  "bugs": "https://github.com/yhay81/vastgrid/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "vastgrid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "vastgrid-source": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "react",
    "datagrid",
    "data-grid",
    "canvas",
    "spreadsheet",
    "csv",
    "parquet",
    "virtual-scroll",
    "big-data"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "vastgrid-core": "^0.1.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
